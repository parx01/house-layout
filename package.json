{
  "name": "plan-66-house-editor",
  "version": "2.0.0-a1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "diagnostic:topology-overlay": "npm run build --silent && node scripts/write-option3-topology-overlay.mjs",
    "diagnostic:topology-overlay:check": "npm run build --silent && node scripts/write-option3-topology-overlay.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
